        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;strokeColor=#007CBD;fontFamily=Helvetica;fontSize=14;fontColor=#232F3E;align=left;verticalAlign=top;spacing=18;" value="&lt;b&gt;Request and runtime flow&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;&lt;b&gt;1&lt;/b&gt; Users reach CloudFront, which serves the SPA from S3 through OAC.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;&lt;b&gt;2&lt;/b&gt; Dynamic API calls route to HTTP API Gateway outside the VPC.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;&lt;b&gt;3&lt;/b&gt; VPC Link forwards hardcoded paths to the internal ALB.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;&lt;b&gt;4&lt;/b&gt; ALB targets private ECS Fargate services.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;&lt;b&gt;5&lt;/b&gt; Services use RDS Proxy, S3, Redis, and Secrets Manager.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;&lt;b&gt;6&lt;/b&gt; Submission jobs go through SQS and DLQ to the worker.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;&lt;b&gt;7&lt;/b&gt; Gaps remain: env drift, Redis auth/TLS, data subnet NAT, and secret rewrite state exposure.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="540" width="620" x="1720" y="30" as="geometry" />
        </mxCell>
      </root>
